# LLM provider: gemini | groq | none
# "none" runs the agent in degraded mode (parsing + retrieval + extractive QA only, no LLM calls).
LLM_PROVIDER=none

# Free-tier keys - only one is required, matching LLM_PROVIDER.
# Get a Gemini key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Get a Groq key at https://console.groq.com/keys
GROQ_API_KEY=

LLM_MODEL=gemini-3.6-flash
# Client-side cap on outbound LLM requests/minute, to stay under free-tier limits.
# 5 matches the observed free-tier cap for gemini-3.6-flash (see README); raise
# this if you switch LLM_MODEL/LLM_PROVIDER to something with a higher quota.
LLM_REQUESTS_PER_MINUTE=5

# Paths (all default under ./data/)
DATA_DIR=./data
PDF_DIR=./data/pdfs
CHROMA_DIR=./data/chroma
OUTPUT_DIR=./data/outputs
CHECKPOINT_DB=./data/checkpoints/checkpoints.sqlite

# Tuning
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
MIN_SIMILARITY=0.3
MAX_PDF_PAGES=60
# Max downloaded PDF size, in MB, before the download is aborted.
MAX_PDF_SIZE_MB=50
# Max candidate papers fetched per arXiv topic search.
ARXIV_MAX_RESULTS=20
# Minimum embedding-similarity score to auto-select a paper without asking the user.
SELECTION_CONFIDENCE_THRESHOLD=0.35
